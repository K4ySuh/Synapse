"""Build and install the retained Phase 5 plus Phase 6B Codex assets offline."""

from __future__ import annotations

import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
from tempfile import TemporaryDirectory
import zipfile


ROOT = Path(__file__).resolve().parents[1]
PROMPT = ROOT / "MCPS" / "Synapse-MCP" / "synapse_mcp" / "operational_prompt.md"
DEFAULT_SKILLS = (
    "operate-synapse",
    "synapse-web-pentesting",
    "synapse-cve-intelligence",
)
MULTI_AGENT_COMPAT_SKILLS = (
    "operate-synapse",
    "synapse-coordinate-engagement",
    "synapse-engagement-bootstrap",
    "synapse-perimeter-triage",
    "synapse-web-assessment",
    "synapse-access-control",
    "synapse-cve-validation",
    "synapse-reporting",
)
SKILL_PROFILES = {
    "default": DEFAULT_SKILLS,
    "multi-agent-compat": MULTI_AGENT_COMPAT_SKILLS,
    "development": ("synapse-developing",),
}


class DistributionError(RuntimeError):
    """A wheel/sdist build, install, or runtime-start check failed."""


def _run(command: list[str], *, cwd: Path, env: dict[str, str] | None = None) -> str:
    completed = subprocess.run(
        command,
        cwd=cwd,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if completed.returncode:
        raise DistributionError(
            f"command failed ({completed.returncode}): {' '.join(command)}\n{completed.stdout}"
        )
    return completed.stdout


def _candidate_pythons() -> list[str]:
    candidates = [
        os.environ.get("SYNAPSE_BUILD_PYTHON", ""),
        sys.executable,
        getattr(sys, "_base_executable", ""),
        shutil.which("python3") or "",
        "/usr/bin/python3",
    ]
    return list(dict.fromkeys(value for value in candidates if value))


def _build_python() -> str:
    for candidate in _candidate_pythons():
        try:
            completed = subprocess.run(
                [candidate, "-c", "import pip, setuptools.build_meta, wheel"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except OSError:
            continue
        if completed.returncode == 0:
            return candidate
    raise DistributionError(
        "no local Python has the declared offline build prerequisites pip, setuptools, and wheel; "
        "set SYNAPSE_BUILD_PYTHON"
    )


def _modern_python() -> str:
    configured = os.environ.get("SYNAPSE_RUNTIME_PYTHON", "").strip()
    if configured:
        candidate = configured
    else:
        completed = subprocess.run(
            [str(ROOT / "bin" / "resolve-synapse-python"), "--require-modern"],
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            check=False,
        )
        if completed.returncode:
            raise DistributionError(f"modern runtime is unavailable: {completed.stdout.strip()}")
        candidate = completed.stdout.strip()
    completed = subprocess.run(
        [candidate, "-c", "import mcp; from mcp.server import MCPServer"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if completed.returncode:
        raise DistributionError(f"modern runtime cannot import the official SDK: {candidate}")
    return candidate


def _copy_source(destination: Path) -> None:
    ignored = shutil.ignore_patterns(
        ".git",
        ".venv",
        ".venv.*",
        ".pytest_cache",
        "__pycache__",
        "*.pyc",
        "*.egg-info",
        "Version-Log.md",
        "build",
        "dist",
        "DATA",
        "reports",
        "Modernization",
    )
    shutil.copytree(ROOT, destination, ignore=ignored)


def _build_archives(python: str, source: Path, output: Path) -> tuple[Path, Path]:
    build_code = (
        "import pathlib, setuptools.build_meta as backend, sys; "
        "out=str(pathlib.Path(sys.argv[1]).resolve()); "
        "print(backend.build_wheel(out)); print(backend.build_sdist(out))"
    )
    _run([python, "-c", build_code, str(output)], cwd=source)
    wheels = sorted(output.glob("*.whl"))
    sdists = sorted(output.glob("*.tar.gz"))
    if len(wheels) != 1 or len(sdists) != 1:
        raise DistributionError(f"expected one wheel and one sdist, got {wheels!r} and {sdists!r}")
    return wheels[0], sdists[0]


def _required_archive_suffixes() -> tuple[str, ...]:
    values = [
        "synapse_mcp/operational_prompt.md",
        "share/synapse-mcp/codex/config/standard.toml",
        "share/synapse-mcp/codex/config/core-only.toml",
        "share/synapse-mcp/codex/config/modern-direct.toml",
        "share/synapse-mcp/codex/config/legacy.toml",
        "share/synapse-mcp/codex/config/multi-agent-compat.toml",
        "share/synapse-mcp/codex/skills/default/operate-synapse/references/operational-invariants.md",
        "share/synapse-mcp/codex/skills/default/operate-synapse/references/single-agent-workflow.md",
        "share/synapse-mcp/codex/skills/default/synapse-web-pentesting/references/auth-and-access-control.md",
        "share/synapse-mcp/codex/skills/default/synapse-cve-intelligence/references/source-and-poc-analysis.md",
        "share/synapse-mcp/codex/skills/multi-agent-compat/operate-synapse/references/operational-invariants.md",
        "share/synapse-mcp/codex/skills/multi-agent-compat/operate-synapse/references/specialist-workflow.md",
    ]
    for profile, skills in SKILL_PROFILES.items():
        for name in skills:
            values.extend(
                (
                    f"share/synapse-mcp/codex/skills/{profile}/{name}/SKILL.md",
                    f"share/synapse-mcp/codex/skills/{profile}/{name}/agents/openai.yaml",
                )
            )
    return tuple(values)


def _assert_archive_contents(wheel: Path, sdist: Path) -> None:
    required = _required_archive_suffixes()
    with zipfile.ZipFile(wheel) as archive:
        wheel_names = tuple(archive.namelist())
    with tarfile.open(sdist, "r:gz") as archive:
        sdist_names = tuple(member.name for member in archive.getmembers() if member.isfile())
    for suffix in required:
        if not any(name.endswith(suffix) for name in wheel_names):
            raise DistributionError(f"wheel is missing {suffix}")
        source_suffix = suffix.replace("share/synapse-mcp/codex/skills/", "skills/codex/").replace(
            "share/synapse-mcp/codex/config/", "config/codex/"
        )
        if not any(name.endswith(source_suffix) for name in sdist_names):
            raise DistributionError(f"sdist is missing {source_suffix}")


def _install(python: str, archive: Path, target: Path) -> None:
    _run(
        [
            python,
            "-m",
            "pip",
            "install",
            "--disable-pip-version-check",
            "--no-deps",
            "--no-build-isolation",
            "--target",
            str(target),
            str(archive),
        ],
        cwd=target.parent,
    )


def _installed_env(target: Path, runtime_root: Path) -> dict[str, str]:
    env = dict(os.environ)
    env.pop("SYNAPSE_PROMPT_PATH", None)
    env["PYTHONPATH"] = str(target)
    env["SYNAPSE_ROOT"] = str(runtime_root)
    env["SYNAPSE_DATA_DIR"] = str(runtime_root / "DATA")
    env["SYNAPSE_DUMP_DIR"] = str(runtime_root / "DATA" / "workspaces")
    env["SYNAPSE_REPORTS_DIR"] = str(runtime_root / "reports")
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return env


def _verify_install(python: str, target: Path, outside: Path, expected_prompt: str) -> None:
    runtime_root = outside / "runtime"
    runtime_root.mkdir(parents=True, exist_ok=True)
    expected_digest = hashlib.sha256(expected_prompt.encode()).hexdigest()
    code = """
import hashlib, sys
from synapse_mcp.integrations.codex import validate_assets
from synapse_mcp.transport.stdio_server import read_main_prompt
prompt = read_main_prompt()
assert hashlib.sha256(prompt.encode()).hexdigest() == sys.argv[1]
assert not validate_assets(), validate_assets()
print(len(prompt.encode()))
"""
    _run(
        [python, "-c", code, expected_digest],
        cwd=outside,
        env=_installed_env(target, runtime_root),
    )
    installed_skills = target / "share" / "synapse-mcp" / "codex" / "skills"
    for profile in ("default", "multi-agent-compat"):
        _run(
            [
                python,
                str(ROOT / "bin" / "validate-codex-skills"),
                "--check",
                "--profile",
                profile,
                "--skills-root",
                str(installed_skills / profile),
            ],
            cwd=outside,
            env=_installed_env(target, runtime_root),
        )


def _verify_pack_start(python: str, target: Path, outside: Path, *, core_only: bool) -> None:
    if core_only:
        code = """
import base64, json, os
from pathlib import Path
import sys
from synapse_mcp.app.capability_packs.bootstrap import select_startup_capability_packs
select_startup_capability_packs(('core',))
from synapse_mcp.app.actions import REGISTRY
from synapse_mcp.app.facade.projections import SurfaceMode
from synapse_mcp.transport.modern.config import ModernAdapterConfig
from synapse_mcp.transport.modern.server import build_runtime
assert len(REGISTRY.descriptors()) == 42
root = Path(os.environ['SYNAPSE_ROOT'])
private = root / 'private'
private.mkdir(parents=True, exist_ok=True)
bindings = private / 'identity-bindings.json'
keyring = private / 'request-state-keyring.json'
bindings.write_text(json.dumps({'version': 1, 'principals': {'phase5e-operator': {'defaultWorkspace': 'phase5e', 'default': {'executionProfile': 'observe', 'authoritySessionId': 'phase5e-session'}, 'workspaces': {'phase5e': {'executionProfile': 'observe', 'authoritySessionId': 'phase5e-session'}}}}}))
keyring.write_text(json.dumps({'version': 1, 'keys': ['base64:' + base64.b64encode(b'phase5e-distribution-key-material').decode()]}))
bindings.chmod(0o600)
keyring.chmod(0o600)
runtime = build_runtime(ModernAdapterConfig(surface=SurfaceMode.MODERN_COMPACT, transport='stdio', server_name='phase5e-core', audience='phase5e-core', identity_bindings_path=bindings, stdio_principal='phase5e-operator', request_state_keyring_path=keyring, state_dir=root / 'DATA' / 'modern-adapter' / 'core', observability='disabled'))
assert len(runtime.capability_packs.registry.descriptors()) == 42
assert 'synapse_mcp.adapters.web.cors' not in sys.modules
assert not any(name.startswith('synapse_mcp.integrations.codex') for name in sys.modules)
print('core-only runtime: 42 actions')
"""
    else:
        code = """
import base64, json, os
from pathlib import Path
import sys
from synapse_mcp.app.actions import REGISTRY
from synapse_mcp.app.facade.projections import SurfaceMode
from synapse_mcp.transport.modern.config import ModernAdapterConfig
from synapse_mcp.transport.modern.server import build_runtime
assert len(REGISTRY.descriptors()) == 174
root = Path(os.environ['SYNAPSE_ROOT'])
private = root / 'private'
private.mkdir(parents=True, exist_ok=True)
bindings = private / 'identity-bindings.json'
keyring = private / 'request-state-keyring.json'
bindings.write_text(json.dumps({'version': 1, 'principals': {'phase5e-operator': {'defaultWorkspace': 'phase5e', 'default': {'executionProfile': 'observe', 'authoritySessionId': 'phase5e-session'}, 'workspaces': {'phase5e': {'executionProfile': 'observe', 'authoritySessionId': 'phase5e-session'}}}}}))
keyring.write_text(json.dumps({'version': 1, 'keys': ['base64:' + base64.b64encode(b'phase5e-distribution-key-material').decode()]}))
bindings.chmod(0o600)
keyring.chmod(0o600)
runtime = build_runtime(ModernAdapterConfig(surface=SurfaceMode.MODERN_COMPACT, transport='stdio', server_name='phase5e-standard', audience='phase5e-standard', identity_bindings_path=bindings, stdio_principal='phase5e-operator', request_state_keyring_path=keyring, state_dir=root / 'DATA' / 'modern-adapter' / 'standard', observability='disabled'))
assert len(runtime.capability_packs.registry.descriptors()) == 174
assert not any(name.startswith('synapse_mcp.integrations.codex') for name in sys.modules)
print('standard runtime: 174 actions')
"""
    _run(
        [python, "-c", code],
        cwd=outside,
        env=_installed_env(target, outside / "runtime"),
    )


def main() -> int:
    build_python = _build_python()
    modern_python = _modern_python()
    expected_prompt = PROMPT.read_text(encoding="utf-8")
    with TemporaryDirectory(prefix="synapse-phase5e-") as temporary:
        temporary_root = Path(temporary)
        source = temporary_root / "source"
        output = temporary_root / "dist"
        output.mkdir()
        _copy_source(source)
        wheel, sdist = _build_archives(build_python, source, output)
        _assert_archive_contents(wheel, sdist)

        wheel_target = temporary_root / "wheel-install"
        sdist_target = temporary_root / "sdist-install"
        outside = temporary_root / "outside-checkout"
        wheel_target.mkdir()
        sdist_target.mkdir()
        outside.mkdir()
        _install(build_python, wheel, wheel_target)
        _install(build_python, sdist, sdist_target)
        _verify_install(build_python, wheel_target, outside, expected_prompt)
        _verify_install(build_python, sdist_target, outside, expected_prompt)
        _verify_pack_start(modern_python, wheel_target, outside, core_only=False)
        _verify_pack_start(modern_python, wheel_target, outside, core_only=True)

        root_lines = len((ROOT / "AGENTS.md").read_text(encoding="utf-8").splitlines())
        print(f"distribution gate: pass ({wheel.name}; {sdist.name})")
        print(f"root instructions: {root_lines} lines")
        print(f"operational prompt: {len(expected_prompt.encode())} bytes")
        print(
            "installed Codex assets: 3 default operating skills; "
            "8 multi-agent compatibility skills; 1 development skill; 5 configs"
        )
        print("installed modern runtime starts: standard 174 actions; core-only 42 actions")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except DistributionError as exc:
        print(f"distribution gate: fail: {exc}", file=sys.stderr)
        raise SystemExit(1)
