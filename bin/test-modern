#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
SYNAPSE_PYTHON="${SYNAPSE_PYTHON:-$ROOT_DIR/.venv/bin/python}"

if [ ! -x "$SYNAPSE_PYTHON" ]; then
    SYNAPSE_PYTHON="${SYNAPSE_PYTHON_FALLBACK:-python3}"
fi

printf 'Running isolated modern MCP spike tests...\n'
PYTHONDONTWRITEBYTECODE=1 \
PYTHONPATH="$ROOT_DIR/MCPS/Synapse-MCP:$ROOT_DIR/MCPS/Synapse-MCP/tests" \
"$SYNAPSE_PYTHON" -m unittest discover "$ROOT_DIR/MCPS/Synapse-MCP/modern_tests" "$@"
