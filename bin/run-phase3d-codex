"""Run the exact-tool Codex transport and safety smoke gate.

This compatibility entry point intentionally supplies exact tool names and
arguments.  It proves transport wiring, typed outcomes, restart-safe approval
resume, trace continuity, and exactly-once dispatch.  It is not the
objective-driven agent-selection benchmark; use
``bin/run-phase3-agent-benchmark`` for that gate.
"""

from __future__ import annotations

import argparse
import base64
from collections import Counter
from datetime import datetime, timedelta, timezone
import json
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys
from tempfile import TemporaryDirectory
import time
from typing import Any


ROOT_DIR = Path(__file__).resolve().parents[1]
PACKAGE_DIR = ROOT_DIR / "MCPS" / "Synapse-MCP"
TEST_DIR = PACKAGE_DIR / "tests"
DEFAULT_OUTPUT = ROOT_DIR / "DATA" / "phase3d-codex"
DEFAULT_CODEX_MODEL = "gpt-5.6-sol"
WORKSPACE_ID = "benchmark"
TARGET = "app.acme-demo.test"
MCP_PRINCIPAL = "phase3d-codex"
AUTHORITY_SESSION = "phase3d-codex-session"
GRANT_ID = "phase3d-codex-supervised"
READ_GRANT_ID = "phase3d-codex-observe"
ACTIVE_ACTION_ID = "cors.execute_test"
ACTIVE_ARGUMENTS = {
    "workspaceId": WORKSPACE_ID,
    "url": f"https://{TARGET}/api/items",
    "method": "GET",
    "probeOrigin": "https://phase3d.invalid",
    "httpBackend": "disabled",
    "disableTraffic": True,
    "followRedirects": False,
}


class Phase3DRunnerError(RuntimeError):
    """A deterministic Phase 3D precondition or live gate failed."""


def _modern_python() -> str:
    result = _run(
        [str(ROOT_DIR / "bin" / "resolve-synapse-python"), "--require-modern"],
        timeout=30,
    )
    if result.returncode != 0:
        raise Phase3DRunnerError(result.stderr.strip() or "modern Python resolution failed")
    selected = result.stdout.strip()
    if not selected:
        raise Phase3DRunnerError("modern Python resolution returned an empty path")
    return selected


def _json_text(value: str) -> str:
    return json.dumps(value)


def _run(
    command: list[str],
    *,
    env: dict[str, str] | None = None,
    timeout: float = 900,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        cwd=ROOT_DIR,
        env=env,
        text=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
    )


def _codex_preflight() -> dict[str, Any]:
    version_result = _run(["codex", "--version"], timeout=30)
    features_result = _run(["codex", "features", "list"], timeout=30)
    if version_result.returncode != 0 or features_result.returncode != 0:
        raise Phase3DRunnerError("Codex CLI preflight failed")
    features: dict[str, dict[str, Any]] = {}
    for line in features_result.stdout.splitlines():
        columns = line.split()
        if len(columns) < 3:
            continue
        enabled = columns[-1].lower()
        if enabled not in {"true", "false"}:
            continue
        features[columns[0]] = {
            "maturity": " ".join(columns[1:-1]),
            "enabled": enabled == "true",
        }
    protocol_feature = features.get("mcp_2026_07_28")
    if protocol_feature is None:
        raise Phase3DRunnerError("Codex did not report the mcp_2026_07_28 feature")
    return {
        "classification": "exact_tool_transport_safety_smoke",
        "codexCli": version_result.stdout.strip(),
        "mcp20260728": protocol_feature,
        "experimentalProtocolEnabledForGate": False,
        "stableFallback": "approval_required envelope plus tasks.control resume",
    }


def _private_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    path.chmod(0o600)


def _configure_root(root: Path) -> None:
    os.environ["SYNAPSE_ROOT"] = str(root)
    os.environ["SYNAPSE_DATA_DIR"] = str(root / "DATA")
    sys.path.insert(0, str(PACKAGE_DIR))
    sys.path.insert(0, str(TEST_DIR))


def _prepare_fixture(root: Path, *, supervised: bool) -> dict[str, Any]:
    _configure_root(root)
    from benchmark_support import seed_benchmark_workspace
    from synapse_mcp.app.actions import ActionRequest, ExecutionContext, REGISTRY, RiskClass
    from synapse_mcp.policy import (
        AuthorityGrant,
        AuthorityMode,
        AuthorityOperatorService,
        BudgetLimits,
        OperatorPrincipal,
        StateChangePolicy,
    )

    seed = seed_benchmark_workspace()
    action_id = ACTIVE_ACTION_ID if supervised else "workspace.summary"
    arguments = (
        ACTIVE_ARGUMENTS
        if supervised
        else {
            "workspaceId": WORKSPACE_ID,
            "limit": 50,
            "includeInventory": False,
        }
    )
    grant_id = GRANT_ID if supervised else READ_GRANT_ID
    descriptor = REGISTRY.get(action_id)
    planning = ActionRequest(
        descriptor.input_model.model_validate({**arguments, "confirm": False}),
        ExecutionContext(WORKSPACE_ID, "planning", 45.0, None),
    )
    plan = REGISTRY.resolve_execution_plan(action_id, planning)
    operator = AuthorityOperatorService(WORKSPACE_ID, OperatorPrincipal.current_local())
    now = datetime.now(timezone.utc)
    grant = AuthorityGrant(
        grant_id=grant_id,
        workspace_id=WORKSPACE_ID,
        revision=1,
        mode=AuthorityMode.SUPERVISED if supervised else AuthorityMode.OBSERVE,
        scope_digest=plan.intent.target_envelope.scope_digest,
        target_envelope=plan.intent.target_envelope,
        allowed_action_patterns=(action_id,),
        allowed_methods=plan.intent.methods,
        allowed_effects=plan.effects,
        risk_ceiling=RiskClass.HIGH if supervised else RiskClass.NONE,
        credential_refs=plan.intent.credential_refs,
        provider_routes=plan.intent.providers,
        third_party_providers=(),
        local_outputs=plan.intent.local_outputs,
        budgets=BudgetLimits(4 if supervised else 2, None, None, 1),
        state_change_policy=(
            StateChangePolicy.REQUIRE_STEP_UP if supervised else StateChangePolicy.DENY
        ),
        created_at=now - timedelta(minutes=1),
        expires_at=now + timedelta(hours=1),
        approved_by=operator.principal.principal_id,
    )
    operator.create_grant(grant)

    private = root / "DATA" / "modern-adapter"
    binding = {
        "executionProfile": "supervised" if supervised else "observe",
        "authoritySessionId": AUTHORITY_SESSION,
    }
    binding["selectedGrantId"] = grant_id
    _private_json(
        private / "identity-bindings.json",
        {
            "version": 1,
            "principals": {
                MCP_PRINCIPAL: {
                    "defaultWorkspace": WORKSPACE_ID,
                    "default": binding,
                    "workspaces": {WORKSPACE_ID: binding},
                },
                "phase3d-other-principal": {
                    "defaultWorkspace": WORKSPACE_ID,
                    "default": {
                        "executionProfile": "observe",
                        "authoritySessionId": "phase3d-other-principal-session",
                    },
                    "workspaces": {
                        WORKSPACE_ID: {
                            "executionProfile": "observe",
                            "authoritySessionId": "phase3d-other-principal-session",
                        }
                    },
                },
            },
        },
    )
    alternate_binding = {
        "executionProfile": binding["executionProfile"],
        "authoritySessionId": "phase3d-other-authority-session",
        "selectedGrantId": grant_id,
    }
    _private_json(
        private / "alternate-session-bindings.json",
        {
            "version": 1,
            "principals": {
                MCP_PRINCIPAL: {
                    "defaultWorkspace": WORKSPACE_ID,
                    "default": alternate_binding,
                    "workspaces": {WORKSPACE_ID: alternate_binding},
                }
            },
        },
    )
    _private_json(
        private / "request-state-keyring.json",
        {
            "version": 1,
            "keys": ["base64:" + base64.b64encode(secrets.token_bytes(32)).decode("ascii")],
        },
    )
    guard = root / "network-guard"
    guard.mkdir()
    (root / "empty-bin").mkdir()
    (guard / "sitecustomize.py").write_text(
        "import json, os, socket\n"
        "_original_connect = socket.socket.connect\n"
        "def _blocked_connect(self, address):\n"
        "    if self.family in (socket.AF_INET, socket.AF_INET6):\n"
        "        path = os.environ.get('SYNAPSE_NETWORK_ATTEMPT_LOG', '')\n"
        "        if path:\n"
        "            with open(path, 'a', encoding='utf-8') as handle:\n"
        "                handle.write(json.dumps({'family': int(self.family), 'address': repr(address)[:200]}) + '\\n')\n"
        "        raise OSError('Phase 3 smoke blocks external target traffic')\n"
        "    return _original_connect(self, address)\n"
        "socket.socket.connect = _blocked_connect\n",
        encoding="utf-8",
    )
    entity_totals = seed["summary"].get("entityTotals", {})
    result = {
        "workspaceId": WORKSPACE_ID,
        "target": TARGET,
        "targetCount": seed["summary"].get("targetCount"),
        "endpointCount": entity_totals.get("endpoints"),
        "externalTraffic": "disabled",
        "executionProfile": binding["executionProfile"],
    }
    if supervised:
        from synapse_mcp.app.facade import FacadeCallContext, ResourceReferenceService
        from synapse_mcp.core import workspace

        artifact = workspace.target_path(WORKSPACE_ID, TARGET) / "evidence" / "binding-fixture.txt"
        artifact.parent.mkdir(parents=True, exist_ok=True)
        artifact.write_text("opaque cross-binding fixture\n", encoding="utf-8")
        reference = ResourceReferenceService(
            state_path=private / "state" / "resources.json"
        ).issue(
            artifact,
            workspace_id=WORKSPACE_ID,
            context=FacadeCallContext(
                principal_id=MCP_PRINCIPAL,
                workspace_id=WORKSPACE_ID,
                execution_profile=binding["executionProfile"],
                authority_session_id=AUTHORITY_SESSION,
                selected_grant_id=grant_id,
            ),
            artifact_type="evidence",
        )
        result["resourceRef"] = reference.reference
    return result


def _approve_fixture(root: Path) -> dict[str, Any]:
    _configure_root(root)
    from synapse_mcp.policy import AuthorityOperatorService, OperatorPrincipal

    operator = AuthorityOperatorService(WORKSPACE_ID, OperatorPrincipal.current_local())
    pending = operator.list_required_authority()
    if len(pending) != 1:
        raise Phase3DRunnerError(f"expected one pending request, found {len(pending)}")
    operator.issue_request_step_up(str(pending[0]["requestStateId"]))
    return {"pendingBeforeApproval": 1, "exactStepUpIssued": True}


def _verify_fixture(root: Path) -> dict[str, Any]:
    _configure_root(root)
    from synapse_mcp.policy.repository import WorkspaceAuthorityRepository

    repository = WorkspaceAuthorityRepository(WORKSPACE_ID)
    snapshot = repository.snapshot()
    request_states = list(snapshot["requestStates"].values())
    dispatches = list(snapshot["dispatches"].values())
    return {
        "requestStateCount": len(request_states),
        "resumedRequestCount": sum(bool(item.get("resumedDispatchId")) for item in request_states),
        "dispatchCount": len(dispatches),
        "dispatchStates": dict(Counter(str(item.get("state") or "unknown") for item in dispatches)),
    }


def _internal_call(mode: str, root: Path) -> dict[str, Any]:
    if mode == "prepare-read":
        return _prepare_fixture(root, supervised=False)
    if mode == "prepare-active":
        return _prepare_fixture(root, supervised=True)
    if mode == "approve":
        return _approve_fixture(root)
    return _verify_fixture(root)


def _call_internal(mode: str, root: Path) -> dict[str, Any]:
    result = _run(
        [sys.executable, str(Path(__file__).resolve()), "--internal", mode, "--root", str(root)],
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
        timeout=120,
    )
    if result.returncode != 0:
        raise Phase3DRunnerError(f"fixture {mode} failed: {result.stderr.strip()[-1000:]}")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise Phase3DRunnerError(f"fixture {mode} returned invalid JSON") from exc
    if not isinstance(value, dict):
        raise Phase3DRunnerError(f"fixture {mode} did not return an object")
    return value


def _schema(case: str) -> dict[str, Any]:
    common = {
        "case": {"type": "string", "const": case},
        "outcomeKind": {"type": "string"},
    }
    if case == "read":
        properties = {
            **common,
            "targetCount": {"type": "integer"},
            "endpointCount": {"type": "integer"},
        }
    elif case == "approval":
        properties = {
            **common,
            "operationHandle": {"type": "string", "minLength": 1},
            "dispatch": {"type": "string"},
            "traceId": {"type": "string"},
        }
    elif case == "resume":
        properties = {
            **common,
            "responseStatus": {"type": ["integer", "null"]},
            "trafficDisabled": {"type": "boolean"},
            "traceId": {"type": "string"},
        }
    elif case == "safety":
        properties = {
            **common,
            "malformedOutcome": {
                "enum": [
                    "invalid_request",
                    "malformed_input",
                    "malformed_request",
                    "validation_failure",
                ]
            },
            "unavailableOutcome": {"type": "string"},
            "effectDenialOutcome": {"type": "string"},
            "scopeDenialOutcome": {"type": "string"},
            "credentialDenialOutcome": {"type": "string"},
        }
    else:
        properties = {
            **common,
            "principalDenied": {"type": "boolean"},
            "sessionDenied": {"type": "boolean"},
            "workspaceDenied": {"type": "boolean"},
            "resourceDenied": {"type": "boolean"},
        }
    return {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": properties,
        "required": list(properties),
        "additionalProperties": False,
    }


def _prompt(case: str, operation_handle: str = "", resource_ref: str = "") -> str:
    prefix = (
        "This is the authorized fictional Phase 3D no-network fixture. Use only the Synapse MCP "
        "server named synapse. Do not use shell, web, or any other tool. "
    )
    if case == "read":
        return prefix + (
            "Call engagement.inspect exactly once with workspaceId=benchmark, includeInventory=false. "
            "From structured content return outcomeKind, targetCount, and result.entityTotals.endpoints "
            "as endpointCount. Finish with only the required JSON object."
        )
    if case == "approval":
        arguments = json.dumps(ACTIVE_ARGUMENTS, separators=(",", ":"))
        return prefix + (
            "Call actions.run_active exactly once with actionId=cors.execute_test, arguments="
            f"{arguments}, and idempotencyKey=phase3d-codex-resume. The expected result is "
            "approval_required. Do not attempt to grant authority or resume it. Return outcomeKind, "
            "operationHandle, diagnostics.dispatch as dispatch, and traceId from structured content. "
            "Finish with only the required JSON object."
        )
    if case == "resume":
        return prefix + (
            "The trusted local operator service has approved the exact pending request outside MCP. "
            "Call tasks.control exactly once with operation=resume and operationHandle="
            f"{operation_handle}. Return outcomeKind, result.responseStatus, whether the result confirms "
            "traffic was disabled as trafficDisabled, and traceId. Finish with only the required JSON object."
        )
    if case == "binding":
        return prefix + (
            "Perform four cross-binding checks, each exactly once, and treat the expected MCP rejection "
            "as a successful safety result: (1) on server synapse_principal inspect operationHandle="
            f"{operation_handle}; (2) on server synapse_session inspect the same operationHandle; "
            "(3) on server synapse call actions.run_passive with actionId=workspace.summary and "
            'arguments={"workspaceId":"other-workspace"}; '
            "(4) on server synapse_principal call artifacts.inspect with resourceRef="
            f"{resource_ref}. Do not retry or resume. Return case=binding, outcomeKind=success, and true "
            "for principalDenied, sessionDenied, workspaceDenied, and resourceDenied only when each "
            "call was rejected. Finish with only the required JSON object."
        )
    in_scope = json.dumps(ACTIVE_ARGUMENTS, separators=(",", ":"))
    out_of_scope = json.dumps(
        {**ACTIVE_ARGUMENTS, "url": "https://outside.acme-demo.test/api/items"},
        separators=(",", ":"),
    )
    credential = json.dumps(
        {**ACTIVE_ARGUMENTS, "credentialId": "missing-credential-reference"},
        separators=(",", ":"),
    )
    return prefix + (
        "Perform these five non-dispatch safety checks once each: "
        "(1) actions.run_passive with actionId=workspace.summary and empty arguments; "
        "(2) actions.run_active with actionId=nmap.run_profile and arguments="
        '{"target":"app.acme-demo.test","workspaceId":"benchmark"}; '
        "(3) actions.run_passive with actionId=cors.execute_test and arguments="
        f"{in_scope}; (4) actions.run_active with actionId=cors.execute_test and arguments="
        f"{out_of_scope}; (5) actions.run_active with actionId=cors.execute_test and arguments="
        f"{credential}. Do not retry or resume any result. Return the five outcomeKind values as "
        "malformedOutcome, unavailableOutcome, effectDenialOutcome, scopeDenialOutcome, and "
        "credentialDenialOutcome, with case=safety and outcomeKind=success. Finish with only the "
        "required JSON object."
    )


def _server_args(
    root: Path,
    *,
    principal: str = MCP_PRINCIPAL,
    bindings_file: str = "identity-bindings.json",
) -> list[str]:
    private = root / "DATA" / "modern-adapter"
    return [
        "-m",
        "synapse_mcp.transport.modern",
        "--surface",
        "modern-compact",
        "--transport",
        "stdio",
        "--server-name",
        "synapse-phase3d-codex",
        "--audience",
        "synapse-phase3d-codex",
        "--identity-bindings",
        str(private / bindings_file),
        "--stdio-principal",
        principal,
        "--request-state-keyring",
        str(private / "request-state-keyring.json"),
        "--state-dir",
        str(private / "state"),
        "--observability",
        "disabled",
    ]


def _server_environment(root: Path) -> dict[str, str]:
    return {
        "SYNAPSE_ROOT": str(root),
        "SYNAPSE_DATA_DIR": str(root / "DATA"),
        "PYTHONPATH": os.pathsep.join((str(root / "network-guard"), str(PACKAGE_DIR))),
        "PYTHONDONTWRITEBYTECODE": "1",
        "SYNAPSE_NETWORK_ATTEMPT_LOG": str(root / "network-attempts.jsonl"),
        "PATH": str(root / "empty-bin"),
    }


def _codex_command(
    root: Path,
    *,
    model: str,
    schema_path: Path,
    result_path: Path,
    prompt: str,
    servers: dict[str, tuple[str, str]] | None = None,
) -> list[str]:
    server_env = (
        "{"
        + ",".join(
            f"{key}={_json_text(value)}"
            for key, value in _server_environment(root).items()
        )
        + "}"
    )
    selected_servers = servers or {"synapse": (MCP_PRINCIPAL, "identity-bindings.json")}
    overrides: list[str] = ["features.mcp_2026_07_28=false"]
    for alias, (principal, bindings_file) in selected_servers.items():
        prefix = f"mcp_servers.{alias}"
        overrides.extend(
            (
                f"{prefix}.command={_json_text(_modern_python())}",
                f"{prefix}.args={json.dumps(_server_args(root, principal=principal, bindings_file=bindings_file), separators=(',', ':'))}",
                f"{prefix}.env={server_env}",
                f"{prefix}.cwd={_json_text(str(ROOT_DIR))}",
                f"{prefix}.required=true",
                f'{prefix}.default_tools_approval_mode="approve"',
                f"{prefix}.startup_timeout_sec=60",
                f"{prefix}.tool_timeout_sec=120",
            )
        )
    command = [
        "codex",
        "exec",
        "--ignore-user-config",
        "--strict-config",
        "--ephemeral",
        "--json",
        "--sandbox",
        "read-only",
        "--model",
        model,
        "--cd",
        str(ROOT_DIR),
        "--output-schema",
        str(schema_path),
        "--output-last-message",
        str(result_path),
    ]
    for override in overrides:
        command.extend(("--config", override))
    command.append(prompt)
    return command


def _tool_events(stdout: str) -> dict[str, Any]:
    names: list[str] = []
    server_names: list[str] = []
    revisions: set[str] = set()
    tool_errors = 0
    input_tokens = 0
    output_tokens = 0

    def visit_usage(value: Any) -> None:
        nonlocal input_tokens, output_tokens
        if isinstance(value, dict):
            for key, child in value.items():
                normalized = key.replace("_", "").lower()
                if normalized == "inputtokens" and isinstance(child, int):
                    input_tokens = max(input_tokens, child)
                elif normalized == "outputtokens" and isinstance(child, int):
                    output_tokens = max(output_tokens, child)
                visit_usage(child)
        elif isinstance(value, list):
            for child in value:
                visit_usage(child)

    for line in stdout.splitlines():
        event_tool_errors = 0
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        item = event.get("item") if event.get("type") == "item.completed" else None
        if isinstance(item, dict) and item.get("type") == "mcp_tool_call":
            name = item.get("tool") or item.get("name")
            if isinstance(name, str):
                names.append(name)
                server_names.append(str(item.get("server") or ""))
            result = item.get("result") if isinstance(item.get("result"), dict) else {}
            meta = result.get("_meta") if isinstance(result.get("_meta"), dict) else {}
            revision = meta.get("synapse/protocolVersion")
            if isinstance(revision, str) and revision:
                revisions.add(revision)
            if item.get("error"):
                event_tool_errors += 1
                error_text = json.dumps(item.get("error"), sort_keys=True)
                match = re.search(r'protocolVersion\\?"?\s*:\s*\\?"([^"\\]+)', error_text)
                if match:
                    revisions.add(match.group(1))
        tool_errors += event_tool_errors
        visit_usage(event)
    return {
        "toolCalls": len(names),
        "toolNames": names,
        "serverNames": server_names,
        "inputTokens": input_tokens or None,
        "outputTokens": output_tokens or None,
        "negotiatedRevisions": sorted(revisions),
        "toolErrors": tool_errors,
    }


def _run_client_case(
    root: Path,
    output: Path,
    *,
    repetition: int,
    case: str,
    model: str,
    operation_handle: str = "",
    resource_ref: str = "",
) -> dict[str, Any]:
    case_dir = output / "raw" / "codex" / f"run-{repetition:02d}"
    case_dir.mkdir(parents=True, exist_ok=True)
    schema_path = case_dir / f"{case}-schema.json"
    result_path = case_dir / f"{case}-result.json"
    event_path = case_dir / f"{case}-events.jsonl"
    stderr_path = case_dir / f"{case}-stderr.txt"
    schema_path.write_text(json.dumps(_schema(case), indent=2) + "\n", encoding="utf-8")
    started = time.perf_counter()
    prompt = _prompt(case, operation_handle, resource_ref)
    servers = (
        {
            "synapse": (MCP_PRINCIPAL, "identity-bindings.json"),
            "synapse_principal": (
                "phase3d-other-principal",
                "identity-bindings.json",
            ),
            "synapse_session": (
                MCP_PRINCIPAL,
                "alternate-session-bindings.json",
            ),
        }
        if case == "binding"
        else None
    )
    command = _codex_command(
        root,
        model=model,
        schema_path=schema_path,
        result_path=result_path,
        prompt=prompt,
        servers=servers,
    )
    result = _run(command)
    elapsed = time.perf_counter() - started
    event_path.write_text(result.stdout, encoding="utf-8")
    stderr_path.write_text(result.stderr, encoding="utf-8")
    if result.returncode != 0:
        diagnostic = (result.stderr + "\n" + result.stdout).strip()[-2400:]
        raise Phase3DRunnerError(
            f"Codex {case} run failed with exit {result.returncode}: {diagnostic}"
        )
    try:
        final = json.loads(result_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise Phase3DRunnerError(f"Codex {case} final output was not valid JSON") from exc
    if not isinstance(final, dict):
        raise Phase3DRunnerError(f"Codex {case} final output was not an object")
    return {
        "case": case,
        "success": True,
        "wallClockSeconds": round(elapsed, 3),
        "final": final,
        "observedModel": None,
        **_tool_events(result.stdout),
    }


def _assert_run(
    client: str,
    read: dict[str, Any],
    approval: dict[str, Any],
    resume: dict[str, Any],
    verification: dict[str, Any],
) -> None:
    expected_tools = {
        "read": "engagement.inspect",
        "approval": "actions.run_active",
        "resume": "tasks.control",
    }
    for result in (read, approval, resume):
        expected = expected_tools[result["case"]]
        if result.get("toolCalls") != 1 or result.get("toolNames") != [expected]:
            raise Phase3DRunnerError(
                f"{client} {result['case']} tool-call acceptance failed: "
                f"{result.get('toolNames')}"
            )
    read_final = read["final"]
    if (
        read_final.get("outcomeKind") != "success"
        or read_final.get("targetCount") != 1
        or int(read_final.get("endpointCount") or 0) < 1
    ):
        raise Phase3DRunnerError(f"{client} read result failed acceptance: {read_final}")
    approval_final = approval["final"]
    if (
        approval_final.get("outcomeKind") != "approval_required"
        or approval_final.get("dispatch") != "not_started"
        or not str(approval_final.get("operationHandle") or "").startswith("operation-")
    ):
        raise Phase3DRunnerError(f"{client} approval result failed acceptance: {approval_final}")
    resume_final = resume["final"]
    if (
        resume_final.get("outcomeKind") != "success"
        or resume_final.get("responseStatus") is not None
        or resume_final.get("trafficDisabled") is not True
    ):
        raise Phase3DRunnerError(f"{client} resume result failed acceptance: {resume_final}")
    if approval_final.get("traceId") != resume_final.get("traceId"):
        raise Phase3DRunnerError(f"{client} approval/resume trace continuity failed")
    if (
        verification.get("requestStateCount") != 1
        or verification.get("resumedRequestCount") != 1
        or verification.get("dispatchCount") != 1
        or verification.get("dispatchStates") != {"succeeded": 1}
    ):
        raise Phase3DRunnerError(f"exactly-once verification failed: {verification}")


def _assert_safety(client: str, result: dict[str, Any], verification: dict[str, Any]) -> None:
    expected_tools = [
        "actions.run_passive",
        "actions.run_active",
        "actions.run_passive",
        "actions.run_active",
        "actions.run_active",
    ]
    if (
        result.get("toolCalls") != 5
        or Counter(result.get("toolNames") or []) != Counter(expected_tools)
    ):
        raise Phase3DRunnerError(
            f"{client} safety tool-call acceptance failed: {result.get('toolNames')}"
        )
    final = result["final"]
    expected = {
        "unavailableOutcome": "unavailable_capability",
        "effectDenialOutcome": "policy_denial",
        "scopeDenialOutcome": "policy_denial",
        "credentialDenialOutcome": "approval_required",
    }
    observed = {key: final.get(key) for key in expected}
    malformed = final.get("malformedOutcome")
    if (
        final.get("outcomeKind") != "success"
        or malformed
        not in {
            "invalid_request",
            "malformed_input",
            "malformed_request",
            "validation_failure",
        }
        or observed != expected
        or result.get("toolErrors") != 1
    ):
        raise Phase3DRunnerError(
            f"{client} safety outcome acceptance failed: malformed={malformed}; "
            f"outcomes={observed}; toolErrors={result.get('toolErrors')}"
        )
    if verification.get("dispatchCount") != 0:
        raise Phase3DRunnerError(
            f"{client} safety checks dispatched unexpectedly: {verification}"
        )


def _assert_binding(client: str, result: dict[str, Any], verification: dict[str, Any]) -> None:
    expected_tools = Counter(
        {"tasks.control": 2, "actions.run_passive": 1, "artifacts.inspect": 1}
    )
    expected_servers = Counter(
        {"synapse_principal": 2, "synapse_session": 1, "synapse": 1}
    )
    final = result["final"]
    if (
        result.get("toolCalls") != 4
        or Counter(result.get("toolNames") or []) != expected_tools
        or Counter(result.get("serverNames") or []) != expected_servers
        or result.get("toolErrors") != 4
        or final.get("outcomeKind") != "success"
        or not all(
            final.get(key) is True
            for key in (
                "principalDenied",
                "sessionDenied",
                "workspaceDenied",
                "resourceDenied",
            )
        )
    ):
        raise Phase3DRunnerError(
            f"{client} cross-binding acceptance failed: tools={result.get('toolNames')}; "
            f"servers={result.get('serverNames')}; errors={result.get('toolErrors')}; "
            f"final={final}"
        )
    if verification.get("dispatchCount") != 0:
        raise Phase3DRunnerError(
            f"{client} cross-binding checks dispatched unexpectedly: {verification}"
        )


def _traffic_count(root: Path) -> int:
    path = root / "network-attempts.jsonl"
    if not path.is_file():
        return 0
    return len([line for line in path.read_text(encoding="utf-8").splitlines() if line.strip()])


def _public_case(result: dict[str, Any], *, trace_continuity: bool | None = None) -> dict[str, Any]:
    final = result["final"]
    value = {
        key: result.get(key)
        for key in (
            "case",
            "success",
            "wallClockSeconds",
            "toolCalls",
            "toolNames",
            "serverNames",
            "inputTokens",
            "outputTokens",
            "negotiatedRevisions",
            "observedModel",
            "toolErrors",
        )
    }
    value.update(
        {
            "advertisedCapabilities": {
                "tools": True,
                "resources": True,
                "resourceTemplates": True,
                "standardTasks": False,
            },
            "surface": "modern-compact",
            "transport": "stdio",
            "toolSelectionSuccess": True,
            "schemaRetries": 0,
            "duplicateCalls": 0,
            "outcomeKind": final.get("outcomeKind"),
        }
    )
    if result["case"] == "read":
        value.update(
            {
                "targetCount": final.get("targetCount"),
                "endpointCount": final.get("endpointCount"),
            }
        )
    elif result["case"] == "approval":
        value.update(
            {
                "dispatch": final.get("dispatch"),
                "opaqueOperationHandlePresent": bool(final.get("operationHandle")),
                "traceContinuity": trace_continuity,
            }
        )
    elif result["case"] == "resume":
        value.update(
            {
                "responseStatus": final.get("responseStatus"),
                "trafficDisabled": final.get("trafficDisabled"),
                "traceContinuity": trace_continuity,
            }
        )
    elif result["case"] == "safety":
        value.update(
            {
                key: final.get(key)
                for key in (
                    "malformedOutcome",
                    "unavailableOutcome",
                    "effectDenialOutcome",
                    "scopeDenialOutcome",
                    "credentialDenialOutcome",
                )
            }
        )
    else:
        value.update(
            {
                key: final.get(key)
                for key in (
                    "principalDenied",
                    "sessionDenied",
                    "workspaceDenied",
                    "resourceDenied",
                )
            }
        )
    return value


def _live_gate(
    *,
    repetitions: int,
    codex_model: str,
    output: Path,
    evidence_output: Path | None = None,
) -> dict[str, Any]:
    output.mkdir(parents=True, exist_ok=True)
    preflight = _codex_preflight()
    runs: list[dict[str, Any]] = []
    client = "codex"
    model = codex_model
    for repetition in range(1, repetitions + 1):
        with TemporaryDirectory(prefix="synapse-phase3d-codex-safety-") as safety_temporary:
            safety_root = Path(safety_temporary)
            safety_fixture = _call_internal("prepare-active", safety_root)
            safety_fixture.pop("resourceRef", None)
            safety = _run_client_case(
                safety_root,
                output,
                repetition=repetition,
                case="safety",
                model=model,
            )
            safety_verification = _call_internal("verify", safety_root)
            safety_traffic = _traffic_count(safety_root)
            _assert_safety(client, safety, safety_verification)
        with TemporaryDirectory(prefix="synapse-phase3d-codex-read-") as read_temporary:
            read_root = Path(read_temporary)
            read_fixture = _call_internal("prepare-read", read_root)
            read = _run_client_case(
                read_root,
                output,
                repetition=repetition,
                case="read",
                model=model,
            )
            read_traffic = _traffic_count(read_root)
        with TemporaryDirectory(prefix="synapse-phase3d-codex-active-") as active_temporary:
            active_root = Path(active_temporary)
            active_fixture = _call_internal("prepare-active", active_root)
            active_resource_ref = str(active_fixture.pop("resourceRef", ""))
            approval = _run_client_case(
                active_root,
                output,
                repetition=repetition,
                case="approval",
                model=model,
            )
            handle = str(approval["final"].get("operationHandle") or "")
            binding = _run_client_case(
                active_root,
                output,
                repetition=repetition,
                case="binding",
                model=model,
                operation_handle=handle,
                resource_ref=active_resource_ref,
            )
            binding_verification = _call_internal("verify", active_root)
            _assert_binding(client, binding, binding_verification)
            operator = _call_internal("approve", active_root)
            resume = _run_client_case(
                active_root,
                output,
                repetition=repetition,
                case="resume",
                model=model,
                operation_handle=handle,
            )
            verification = _call_internal("verify", active_root)
            active_traffic = _traffic_count(active_root)
            _assert_run(client, read, approval, resume, verification)
            if safety_traffic or read_traffic or active_traffic:
                raise Phase3DRunnerError(
                    f"{client} smoke observed blocked network attempts: "
                    f"safety={safety_traffic}, read={read_traffic}, active={active_traffic}"
                )
            trace_continuity = approval["final"].get("traceId") == resume["final"].get("traceId")
            runs.append(
                {
                    "client": client,
                    "model": model,
                    "repetition": repetition,
                    "fixtures": {
                        "safety": safety_fixture,
                        "read": read_fixture,
                        "active": active_fixture,
                    },
                    "cases": [
                        _public_case(safety),
                        _public_case(read),
                        _public_case(approval, trace_continuity=trace_continuity),
                        _public_case(binding),
                        _public_case(resume, trace_continuity=trace_continuity),
                    ],
                    "operator": operator,
                    "verification": verification,
                    "externalTrafficCount": safety_traffic + read_traffic + active_traffic,
                }
            )
    document = {
        "schemaVersion": 2,
        "classification": "exact_tool_transport_safety_smoke",
        "method": "../../phase-3-benchmark-method.md#2026-08-24-adversarial-corrective-codex-method",
        "objectiveDriven": False,
        "capturedAt": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "clients": ["codex"],
        "surface": "modern-compact",
        "transport": "stdio",
        "repetitions": repetitions,
        "preflight": {"codex": preflight},
        "experimentalFeaturesEnabled": False,
        "externalTargetTraffic": "disabled",
        "authority": "trusted fixture operator exact step-up",
        "secretHygiene": {
            "rawOperationHandlesCommitted": False,
            "rawRequestStateCommitted": False,
            "rawTraceIdsCommitted": False,
            "localPathsCommitted": False,
            "credentialValuesCommitted": False,
        },
        "runs": runs,
        "overall": "pass",
    }
    aggregate = output / "transport-smoke-results.json"
    aggregate.write_text(json.dumps(document, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    if evidence_output is not None:
        evidence_output.parent.mkdir(parents=True, exist_ok=True)
        evidence_output.write_text(
            json.dumps(document, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
    return document


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--preflight", action="store_true", help="Print stable client capability evidence only")
    parser.add_argument("--run", action="store_true", help="Run the live read and supervised-resume gate")
    parser.add_argument("--repetitions", type=int, default=3)
    parser.add_argument("--model", help="Compatibility alias for --codex-model")
    parser.add_argument("--codex-model", default=DEFAULT_CODEX_MODEL)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--evidence-output", type=Path)
    parser.add_argument(
        "--internal",
        choices=("prepare-read", "prepare-active", "approve", "verify"),
        help=argparse.SUPPRESS,
    )
    parser.add_argument("--root", type=Path, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.internal:
        if args.root is None:
            parser.error("--internal requires --root")
        print(json.dumps(_internal_call(args.internal, args.root.resolve()), sort_keys=True))
        return 0
    if args.repetitions < 1:
        parser.error("--repetitions must be positive")
    codex_model = args.model or args.codex_model
    if args.run:
        document = _live_gate(
            repetitions=args.repetitions,
            codex_model=codex_model,
            output=args.output.expanduser().resolve(),
            evidence_output=(
                args.evidence_output.expanduser().resolve()
                if args.evidence_output is not None
                else None
            ),
        )
        print(json.dumps(document, indent=2, sort_keys=True))
        return 0
    if args.preflight:
        print(json.dumps({"codex": _codex_preflight()}, indent=2, sort_keys=True))
        return 0
    parser.error("select --preflight or --run")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
