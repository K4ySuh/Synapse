"""Generate or verify the Phase 3 MCP surface payload fixtures."""

from __future__ import annotations

import argparse
import asyncio
from hashlib import sha256
import json
import os
from pathlib import Path
import subprocess
import sys
from tempfile import TemporaryDirectory
from typing import Any
from unittest.mock import patch


ROOT_DIR = Path(__file__).resolve().parents[1]
PACKAGE_DIR = ROOT_DIR / "MCPS" / "Synapse-MCP"
FIXTURE_DIR = PACKAGE_DIR / "tests" / "fixtures" / "phase3d"
MANIFEST_PATH = FIXTURE_DIR / "payload-manifest.json"
if os.environ.get("SYNAPSE_SURFACE_RUNTIME_RESOLVED") != "1":
    resolved = subprocess.run(
        [str(ROOT_DIR / "bin" / "resolve-synapse-python"), "--require-modern"],
        text=True,
        capture_output=True,
        check=False,
    )
    if resolved.returncode != 0:
        print(resolved.stderr.strip() or resolved.stdout.strip(), file=sys.stderr)
        raise SystemExit(resolved.returncode)
    environment = dict(os.environ)
    environment["SYNAPSE_SURFACE_RUNTIME_RESOLVED"] = "1"
    os.execve(resolved.stdout.strip(), [resolved.stdout.strip(), str(Path(__file__).resolve()), *sys.argv[1:]], environment)
if str(PACKAGE_DIR) not in sys.path:
    sys.path.insert(0, str(PACKAGE_DIR))


def _surface_values() -> tuple[tuple[str, list[dict[str, Any]]], ...]:
    from synapse_mcp.app.facade import CompactProjection, DirectProjection
    from synapse_mcp.transport.stdio_server import TOOL_SCHEMAS

    return (
        ("legacy", list(TOOL_SCHEMAS)),
        (
            "modern-compact",
            [
                operation.model_dump(mode="json", by_alias=True)
                for operation in CompactProjection().operations()
            ],
        ),
        (
            "modern-direct",
            [
                operation.model_dump(mode="json", by_alias=True)
                for operation in DirectProjection().operations()
            ],
        ),
    )


def _serialize(value: list[dict[str, Any]]) -> bytes:
    # This is the frozen Phase 0/3 payload boundary. Keep json.dumps defaults:
    # ensure_ascii=True accounts for the six-byte legacy baseline delta.
    return json.dumps(value, separators=(",", ":")).encode("utf-8")


async def _sdk_wire_values() -> tuple[dict[str, dict[str, list[dict[str, Any]]]], str]:
    from importlib.metadata import version

    from mcp import Client
    from mcp_types.version import HANDSHAKE_PROTOCOL_VERSIONS, MODERN_PROTOCOL_VERSIONS

    from synapse_mcp.app.facade.projections import SurfaceMode
    from synapse_mcp.core import paths
    from synapse_mcp.transport.modern.config import ModernAdapterConfig
    from synapse_mcp.transport.modern.server import build_runtime

    paths.DATA_DIR.mkdir(parents=True, exist_ok=True)
    values: dict[str, dict[str, list[dict[str, Any]]]] = {}
    revisions = (*MODERN_PROTOCOL_VERSIONS, *HANDSHAKE_PROTOCOL_VERSIONS)
    with TemporaryDirectory(prefix="phase3-surface-", dir=paths.DATA_DIR) as temporary:
        root = Path(temporary)
        bindings = root / "identity-bindings.json"
        keyring = root / "request-state-keyring.json"
        bindings.write_text(
            json.dumps(
                {
                    "version": 1,
                    "principals": {
                        "surface-measurement": {
                            "defaultWorkspace": "measurement",
                            "default": {
                                "executionProfile": "observe",
                                "authoritySessionId": "surface-measurement-session",
                            },
                            "workspaces": {},
                        }
                    },
                }
            ),
            encoding="utf-8",
        )
        keyring.write_text(json.dumps({"version": 1, "keys": ["hex:" + "42" * 32]}), encoding="utf-8")
        bindings.chmod(0o600)
        keyring.chmod(0o600)
        for surface in (SurfaceMode.MODERN_COMPACT, SurfaceMode.MODERN_DIRECT):
            runtime = build_runtime(
                ModernAdapterConfig(
                    surface=surface,
                    transport="stdio",
                    server_name="synapse-surface-measurement",
                    audience="synapse-surface-measurement",
                    identity_bindings_path=bindings,
                    stdio_principal="surface-measurement",
                    request_state_keyring_path=keyring,
                    state_dir=root / f"state-{surface.value}",
                    observability="disabled",
                )
            )
            by_revision: dict[str, list[dict[str, Any]]] = {}
            for revision in revisions:
                with patch("mcp.client.session.LATEST_HANDSHAKE_VERSION", revision):
                    mode = revision if revision in MODERN_PROTOCOL_VERSIONS else "legacy"
                    async with Client(runtime.server, mode=mode) as client:
                        discovered = await client.list_tools()
                        negotiated = str(client.protocol_version)
                        if negotiated != revision:
                            raise RuntimeError(f"requested {revision}, negotiated {negotiated}")
                        by_revision[revision] = [
                            tool.model_dump(mode="json", by_alias=True, exclude_none=True)
                            for tool in discovered.tools
                        ]
            values[surface.value] = by_revision
    return values, version("mcp")


def _document() -> tuple[dict[str, Any], dict[str, bytes]]:
    payloads: dict[str, bytes] = {}
    application_measurements: dict[str, dict[str, Any]] = {}
    for name, value in _surface_values():
        payload = _serialize(value)
        payloads[name] = payload
        application_measurements[name] = {
            "toolCount": len(value),
            "compactUtf8Bytes": len(payload),
            "sha256": sha256(payload).hexdigest(),
            "fixture": f"{name}-tools.json",
        }
    wire_values, sdk_version = asyncio.run(_sdk_wire_values())
    wire_measurements: dict[str, dict[str, Any]] = {}
    for surface, by_revision in wire_values.items():
        fixtures_by_hash: dict[str, str] = {}
        revision_measurements: dict[str, Any] = {}
        for revision, value in by_revision.items():
            payload = _serialize(value)
            digest = sha256(payload).hexdigest()
            fixture_key = fixtures_by_hash.get(digest)
            if fixture_key is None:
                fixture_key = f"sdk-{surface}-{revision}"
                fixtures_by_hash[digest] = fixture_key
                payloads[fixture_key] = payload
            revision_measurements[revision] = {
                "toolCount": len(value),
                "compactUtf8Bytes": len(payload),
                "sha256": digest,
                "fixture": f"{fixture_key}-tools.json",
            }
        wire_measurements[surface] = {"revisions": revision_measurements}
    legacy_bytes = application_measurements["legacy"]["compactUtf8Bytes"]
    compact_bytes = application_measurements["modern-compact"]["compactUtf8Bytes"]
    wire_compact_bytes = next(iter(wire_measurements["modern-compact"]["revisions"].values()))[
        "compactUtf8Bytes"
    ]
    return (
        {
            "schemaVersion": 2,
            "serialization": "json.dumps(value, separators=(',', ':')).encode('utf-8')",
            "legacyBaselineBytes": 99_337,
            "compactMaximumBytes": 24_834,
            "compactStrictlyBelowLegacyQuarter": compact_bytes * 4 < legacy_bytes,
            "applicationProjection": {
                "description": "Transport-independent ApplicationOperation projection",
                "surfaces": application_measurements,
            },
            "officialSdkWire": {
                "description": "Official Python SDK Tool objects returned by MCP tools/list",
                "sdkVersion": sdk_version,
                "surfaces": wire_measurements,
                "compactWithinMaximum": wire_compact_bytes <= 24_834,
            },
        },
        payloads,
    )


def _write() -> int:
    document, payloads = _document()
    FIXTURE_DIR.mkdir(parents=True, exist_ok=True)
    for name, payload in payloads.items():
        filename = f"{name}-tools.json" if not name.startswith("sdk-") else f"{name}-tools.json"
        (FIXTURE_DIR / filename).write_bytes(payload + b"\n")
    MANIFEST_PATH.write_text(
        json.dumps(document, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    print(f"wrote Phase 3 surface fixtures: {FIXTURE_DIR}")
    return 0


def _check() -> int:
    document, payloads = _document()
    failures: list[str] = []
    if not MANIFEST_PATH.is_file():
        failures.append(f"missing {MANIFEST_PATH}")
    else:
        try:
            actual_manifest = json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            failures.append(f"invalid {MANIFEST_PATH}: {exc}")
        else:
            if actual_manifest != document:
                failures.append(f"stale {MANIFEST_PATH}")
    for name, payload in payloads.items():
        path = FIXTURE_DIR / f"{name}-tools.json"
        if not path.is_file():
            failures.append(f"missing {path}")
            continue
        if path.read_bytes() != payload + b"\n":
            failures.append(f"stale {path}")
    legacy = document["applicationProjection"]["surfaces"]["legacy"]
    compact = document["applicationProjection"]["surfaces"]["modern-compact"]
    if legacy["toolCount"] != 174 or legacy["compactUtf8Bytes"] != 99_337:
        failures.append("legacy payload boundary changed")
    if compact["toolCount"] != 11 or compact["compactUtf8Bytes"] > 24_834:
        failures.append("modern-compact payload gate failed")
    if not document["compactStrictlyBelowLegacyQuarter"]:
        failures.append("modern-compact is not strictly below 25% of legacy")
    if not document["officialSdkWire"]["compactWithinMaximum"]:
        failures.append("official-SDK modern-compact wire payload gate failed")
    if failures:
        for failure in failures:
            print(f"FAIL {failure}", file=sys.stderr)
        return 1
    print(
        "Phase 3 surface fixtures are current: "
        f"legacy={legacy['compactUtf8Bytes']} bytes, "
        f"compact={compact['compactUtf8Bytes']} bytes"
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--write", action="store_true")
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--json", action="store_true")
    args = parser.parse_args()
    if args.write:
        return _write()
    if args.check:
        return _check()
    document, _ = _document()
    print(json.dumps(document, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
