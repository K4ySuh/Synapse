#!/usr/bin/env sh
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
ENV_FILE="${SYNAPSE_ENV_FILE:-$ROOT_DIR/config/synapse.env}"
SYNAPSE_ROOT="$ROOT_DIR"
export SYNAPSE_ROOT
if [ -f "$ENV_FILE" ]; then
    # shellcheck disable=SC1090
    . "$ENV_FILE"
fi

profile=all
strict_tools=0
legacy_ready=0
modern_ready=0
tooling_ready=0

usage() {
    cat <<'EOF'
Usage: bin/check-setup [--all|--legacy|--modern] [--strict-tools]

Reports legacy and modern readiness independently. The default --all fails if
either selected runtime is not ready. Modern readiness requires operator-owned
private identity/keyring material and a writable state directory.
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --all) profile=all ;;
        --legacy) profile=legacy ;;
        --modern) profile=modern ;;
        --strict-tools) strict_tools=1 ;;
        --help|-h) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

provision_version_log() {
    log="$ROOT_DIR/docs/Version-Log.md"
    template="$ROOT_DIR/docs/Version-Log.template.md"
    if [ -f "$log" ]; then
        printf 'OK   local Version-Log present: %s\n' "$log"
    elif [ -f "$template" ] && cp "$template" "$log" 2>/dev/null; then
        printf 'OK   created local gitignored Version-Log: %s\n' "$log"
    else
        printf 'WARN local Version-Log is unavailable; copy %s manually\n' "$template"
    fi
}

check_external_tool() {
    name="$1"
    if command -v "$name" >/dev/null 2>&1; then
        printf 'OK   optional adapter executable %s: %s\n' "$name" "$(command -v "$name")"
    elif [ "$strict_tools" -eq 1 ]; then
        printf 'MISS optional adapter executable %s (required by --strict-tools)\n' "$name"
        tooling_ready=1
    else
        printf 'WARN optional adapter executable %s is not installed\n' "$name"
    fi
}

printf 'Synapse setup check\nRepository: %s\n\n' "$ROOT_DIR"
provision_version_log

if [ ! -f "$ENV_FILE" ]; then
    printf 'MISS shared environment file: %s\n' "$ENV_FILE"
    legacy_ready=1
else
    printf 'OK   shared environment file: %s\n' "$ENV_FILE"
fi
if [ ! -f "$ROOT_DIR/AGENTS.md" ]; then
    printf 'MISS agent instructions: %s\n' "$ROOT_DIR/AGENTS.md"
    legacy_ready=1
fi

if SYNAPSE_PYTHON_RESOLVED=$("$ROOT_DIR/bin/resolve-synapse-python" 2>&1); then
    printf 'OK   selected Python: %s\n' "$SYNAPSE_PYTHON_RESOLVED"
else
    printf 'MISS selected Python: %s\n' "$SYNAPSE_PYTHON_RESOLVED"
    legacy_ready=1
    modern_ready=1
    SYNAPSE_PYTHON_RESOLVED=""
fi

if [ -n "$SYNAPSE_PYTHON_RESOLVED" ]; then
    for module in httpx pydantic; do
        if "$SYNAPSE_PYTHON_RESOLVED" -c "import $module" >/dev/null 2>&1; then
            printf 'OK   legacy dependency %s\n' "$module"
        else
            printf 'MISS legacy dependency %s\n' "$module"
            legacy_ready=1
        fi
    done
fi

for tool in sqlmap ffuf nmap nuclei; do
    check_external_tool "$tool"
done

printf '\nLegacy runtime check:\n'
LEGACY_LAUNCHER="$ROOT_DIR/MCPS/Synapse-MCP/bin/synapse-mcp"
if [ ! -x "$LEGACY_LAUNCHER" ]; then
    printf 'MISS frozen legacy launcher is not executable: %s\n' "$LEGACY_LAUNCHER"
    legacy_ready=1
elif response=$(printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}' |
    PYTHONDONTWRITEBYTECODE=1 "$LEGACY_LAUNCHER" 2>&1); then
    case "$response" in
        *'"tools"'*'"jobs.list"'*'"fingerprint.from_dump"'*)
            printf 'OK   frozen legacy tools/list starts and exposes expected tools\n' ;;
        *)
            printf 'MISS frozen legacy tools/list response is incomplete\n'
            legacy_ready=1 ;;
    esac
else
    printf 'MISS frozen legacy launcher failed to start\n'
    printf '%s\n' "$response" | sed 's/^/     /'
    legacy_ready=1
fi

printf '\nModern runtime check:\n'
if [ -n "$SYNAPSE_PYTHON_RESOLVED" ]; then
    if MODERN_PYTHON=$("$ROOT_DIR/bin/resolve-synapse-python" --require-modern 2>&1); then
        printf 'OK   modern Python: %s\n' "$MODERN_PYTHON"
    else
        printf 'MISS modern Python: %s\n' "$MODERN_PYTHON"
        modern_ready=1
        MODERN_PYTHON=""
    fi
else
    MODERN_PYTHON=""
fi

IDENTITY_BINDINGS="${SYNAPSE_MODERN_IDENTITY_BINDINGS:-$ROOT_DIR/DATA/modern-adapter/identity-bindings.json}"
REQUEST_STATE_KEYRING="${SYNAPSE_MODERN_REQUEST_STATE_KEYRING:-$ROOT_DIR/DATA/modern-adapter/request-state-keyring.json}"
MODERN_STATE_DIR="${SYNAPSE_MODERN_STATE_DIR:-$ROOT_DIR/DATA/modern-adapter/state}"
MODERN_PRINCIPAL="${SYNAPSE_MODERN_STDIO_PRINCIPAL:-local-operator}"
MODERN_WORKSPACE="${SYNAPSE_MODERN_WORKSPACE:-}"
if [ -n "$MODERN_PYTHON" ]; then
    set -- --identity-bindings "$IDENTITY_BINDINGS" \
        --request-state-keyring "$REQUEST_STATE_KEYRING" \
        --state-dir "$MODERN_STATE_DIR" \
        --principal "$MODERN_PRINCIPAL"
    if [ -n "$MODERN_WORKSPACE" ]; then
        set -- "$@" --workspace "$MODERN_WORKSPACE"
    fi
    if readiness=$(PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$ROOT_DIR/MCPS/Synapse-MCP" \
        "$MODERN_PYTHON" -m synapse_mcp.transport.modern.readiness "$@" 2>&1); then
        printf '%s\n' "$readiness"
    else
        printf '%s\n' "$readiness"
        modern_ready=1
    fi
fi

printf '\nReadiness summary:\n'
if [ "$legacy_ready" -eq 0 ]; then
    printf 'LEGACY READY — frozen wire adapter using the canonical Registry\n'
else
    printf 'LEGACY NOT READY\n'
fi
if [ "$modern_ready" -eq 0 ]; then
    printf 'MODERN READY — official SDK adapter and trusted operator material validated\n'
else
    printf 'MODERN NOT READY — provision private 0600 bindings/keyring and a writable state directory\n'
fi

case "$profile" in
    legacy) selected_status=$legacy_ready ;;
    modern) selected_status=$modern_ready ;;
    all)
        selected_status=$legacy_ready
        if [ "$modern_ready" -ne 0 ]; then selected_status=$modern_ready; fi ;;
esac
if [ "$tooling_ready" -ne 0 ]; then selected_status=$tooling_ready; fi
exit "$selected_status"
