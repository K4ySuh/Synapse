# Repository-local environment for Synapse MCP launchers.
#
# The bin/* launchers set SYNAPSE_ROOT before sourcing this file. Values
# can still be overridden by exporting the same variable before launching a server.

SYNAPSE_ROOT="${SYNAPSE_ROOT:-}"
if [ -z "$SYNAPSE_ROOT" ]; then
    SYNAPSE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
fi

MCP_SSE_URL="${MCP_SSE_URL:-http://127.0.0.1:9876}"
BURP_MCP_PROXY_JAR="${BURP_MCP_PROXY_JAR:-$SYNAPSE_ROOT/MCPS/Burp-Mcp/mcp-proxy.jar}"

SQLMAP_BIN="${SQLMAP_BIN:-sqlmap}"
FFUF_BIN="${FFUF_BIN:-ffuf}"
NMAP_BIN="${NMAP_BIN:-nmap}"
NUCLEI_BIN="${NUCLEI_BIN:-nuclei}"
SYNAPSE_CVE_NVD_URL="${SYNAPSE_CVE_NVD_URL:-https://services.nvd.nist.gov/rest/json/cves/2.0}"
SYNAPSE_CVE_KEV_URL="${SYNAPSE_CVE_KEV_URL:-https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json}"
SYNAPSE_CVE_POC_GITHUB_URL="${SYNAPSE_CVE_POC_GITHUB_URL:-https://raw.githubusercontent.com/nomi-sec/PoC-in-GitHub/master/{year}/{cveId}.json}"
SYNAPSE_CVE_GITHUB_SEARCH_URL="${SYNAPSE_CVE_GITHUB_SEARCH_URL:-https://api.github.com/search/repositories}"
SYNAPSE_CVE_SOURCES="${SYNAPSE_CVE_SOURCES:-nvd,shodan,poc_github_index,cisa_kev}"
SYNAPSE_MCP_TOOL_TIMEOUT_SECONDS="${SYNAPSE_MCP_TOOL_TIMEOUT_SECONDS:-45}"
SYNAPSE_MCP_FAST_TOOL_TIMEOUT_SECONDS="${SYNAPSE_MCP_FAST_TOOL_TIMEOUT_SECONDS:-15}"
SYNAPSE_MCP_STATUS_TOOL_TIMEOUT_SECONDS="${SYNAPSE_MCP_STATUS_TOOL_TIMEOUT_SECONDS:-30}"
# Tool executor workers. The stdin loop is single-flight; spare workers exist so
# a timed-out (un-killable) tool thread cannot starve jobs.status/jobs.cancel.
SYNAPSE_MCP_TOOL_WORKERS="${SYNAPSE_MCP_TOOL_WORKERS:-4}"
if [ -z "${SYNAPSE_PYTHON:-}" ]; then
    if [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
        SYNAPSE_PYTHON="$VIRTUAL_ENV/bin/python"
    else
        SYNAPSE_PYTHON="$SYNAPSE_ROOT/.venv/bin/python"
    fi
fi

SYNAPSE_PROMPT_PATH="${SYNAPSE_PROMPT_PATH:-$SYNAPSE_ROOT/AGENTS.md}"
# Synapse runtime data is intentionally rooted under SYNAPSE_ROOT. Relative
# values resolve from SYNAPSE_ROOT or SYNAPSE_DATA_DIR, not the launch cwd.
SYNAPSE_DATA_DIR="${SYNAPSE_DATA_DIR:-$SYNAPSE_ROOT/DATA}"
SYNAPSE_DUMP_DIR="${SYNAPSE_DUMP_DIR:-$SYNAPSE_DATA_DIR/workspaces}"

export SYNAPSE_ROOT
export MCP_SSE_URL
export BURP_MCP_PROXY_JAR
export SQLMAP_BIN
export FFUF_BIN
export NMAP_BIN
export NUCLEI_BIN
export SYNAPSE_CVE_NVD_URL
export SYNAPSE_CVE_KEV_URL
export SYNAPSE_CVE_POC_GITHUB_URL
export SYNAPSE_CVE_GITHUB_SEARCH_URL
export SYNAPSE_CVE_SOURCES
export SYNAPSE_MCP_TOOL_TIMEOUT_SECONDS
export SYNAPSE_MCP_FAST_TOOL_TIMEOUT_SECONDS
export SYNAPSE_MCP_STATUS_TOOL_TIMEOUT_SECONDS
export SYNAPSE_MCP_TOOL_WORKERS
export SYNAPSE_PYTHON
export SYNAPSE_PROMPT_PATH
export SYNAPSE_DUMP_DIR
export SYNAPSE_DATA_DIR
